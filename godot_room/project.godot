config_version=5
[application]
run/main_scene="res://room.tscn"
config/name="Xinyu Shared Room"
[editor_plugins]
enabled=PackedStringArray("res://addons/Godot-MToon-Shader/plugin.cfg", "res://addons/vrm/plugin.cfg")
[rendering]
renderer/rendering_method="forward_plus"

[navigation]
3d/default_cell_size=0.125
3d/default_cell_height=0.1

[audio]
driver/enable_input=true
